// ============================================================
// EdgeNode
// Represents one edge in the adjacency list.
//
// vtx    : destination vertex
// weight : edge weight
// next   : pointer to the next edge
// ============================================================

struct EdgeNode {
    int vtx;
    int weight;
    EdgeNode* next;

    EdgeNode(int vtx, int weight)
        : vtx(vtx), weight(weight), next(nullptr) {}
};

